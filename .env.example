# Upstream API key Fuse forwards with (OpenAI / Anthropic / compatible).
FUSE_UPSTREAM_API_KEY=sk-replace-me

# Optional upstream override (Compose demo uses http://demogen:18080).
# FUSE_UPSTREAM_BASE_URL=https://api.openai.com
# FUSE_UPSTREAM_PROVIDER=openai

# Postgres (Docker Compose sets this automatically).
# Neon: paste the pooled connection string (sslmode=require).
FUSE_DATABASE_URL=postgres://fuse:fuse@localhost:5432/fuse?sslmode=disable

# Slack incoming webhook for budget alerts.
# FUSE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional SMTP alerts
# FUSE_SMTP_ADDR=localhost:1025
# FUSE_SMTP_FROM=fuse@example.com
# FUSE_SMTP_TO=ops@example.com
